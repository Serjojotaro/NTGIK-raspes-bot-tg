# Токен бота от @BotFather (обязательно для обеих реализаций)
BOT_TOKEN=123456:ABC-def

# --- http_bot (aiogram, Bot API HTTPS) ---
# HTTP/SOCKS5-прокси только для Telegram API (сайт расписания всегда ходит напрямую)
# TELEGRAM_PROXY=http://user:pass@proxy.example.com:3128
# TELEGRAM_PROXY=http://proxy.eltex.loc:3128

# --- mtproto_bot (Telethon, MTProto) ---
# api_id/api_hash — https://my.telegram.org (обязательно для mtproto_bot)
# API_ID=123456
# API_HASH=0123456789abcdef0123456789abcdef
# MTProxy из ссылки tg://proxy?server=HOST&port=PORT&secret=SECRET
# MT_PROXY_HOST=5.130.184.205
# MT_PROXY_PORT=443
# MT_PROXY_SECRET=ee...
# MT_SESSION=ntgik-bot.session

